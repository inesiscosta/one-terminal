{
  "name": "one-terminal",
  "version": "1.2.1",
  "description": "One \"fake\" terminal to rule them all! A React terminal component.",
  "keywords": [
    "react",
    "terminal",
    "portfolio",
    "component",
    "headless",
    "fake"
  ],
  "author": "Inês Costa",
  "license": "MIT",
  "homepage": "https://one-terminal.inesiscosta.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inesiscosta/one-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/inesiscosta/one-terminal/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm type-check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "dev:website": "turbo dev --filter=website",
    "build:website": "turbo build --filter=website",
    "prepare": "husky",
    "prepublishOnly": "pnpm type-check && pnpm test && pnpm build"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "website/src/**/*.{ts,tsx}": [
      "pnpm --dir website exec eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,cjs,json,md,mdx,yml,yaml,css}": "prettier --write"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "turbo": "2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@9.15.9"
}
