{
  "name": "one-terminal",
  "version": "1.3.0",
  "description": "One \"fake\" terminal to rule them all! A React terminal component.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "dev:website": "turbo dev --filter=website",
    "build:website": "turbo build --filter=website",
    "format": "prettier --write ."
  },
  "keywords": [
    "react",
    "terminal",
    "portfolio",
    "component",
    "headless",
    "fake"
  ],
  "author": "Inês Costa",
  "license": "MIT",
  "homepage": "https://one-terminal.inesiscosta.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inesiscosta/one-terminal.git"
  },
  "bugs": {
    "url": "https://github.com/inesiscosta/one-terminal/issues"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.7.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "turbo": "2.6.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "packageManager": "pnpm@9.15.9"
}